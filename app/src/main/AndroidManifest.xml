<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCar">
        <activity
            android:name=".ui.catalog.VehicleCatalogActivity"
            android:exported="false"
            android:label="Catalog modele auto"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.localnotes.LocalNotesActivity"
            android:exported="false"
            android:label="Note locale"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.car.MaintenanceListActivity"
            android:exported="false"
            android:label="Istoric Service"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.car.AddMaintenanceActivity"
            android:exported="false"
            android:label="Adaugă Intervenție"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.car.CarListActivity"
            android:exported="false"
            android:label="@string/title_activity_car_list"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.car.AddCarActivity"
            android:exported="false"
            android:label="@string/title_activity_add_car"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:label="@string/title_activity_dashboard"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="@string/title_activity_register"
            android:theme="@style/Theme.MyCar" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyCar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
