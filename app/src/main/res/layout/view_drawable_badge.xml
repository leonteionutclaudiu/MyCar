<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/drawableHeader"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/mycar_gradient_background"
        android:gravity="center"
        android:minHeight="52dp"
        android:text="Verificare documente pornită"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drawableBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/mycar_badge_selector"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="Verificare automată documente activă"
        android:textColor="@color/mycar_badge_text_selector"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
